# Copia este archivo a .env y completa los valores.
#   cp .env.example .env
#
# Ningún valor de este archivo es real: son placeholders o los defaults públicos
# ya presentes en core_erp/settings.py. Regla de nombres y catálogo completo:
# docs/variables_entorno.md (ORIGEN_SERVICIO_DATO). Los nombres anteriores siguen
# valiendo como respaldo durante el corte, con un aviso en el log.

# ─── Exentas (las define Railway) ─────────────────────────────────────────
# Si no se define, cae a SQLite local (db.sqlite3). Formato: postgres://usuario:password@host:puerto/nombre
DATABASE_URL=

# ─── DJANGO — framework ────────────────────────────────────────────────────

# Llave de firma de sesiones y tokens; sin valor por defecto, el servidor no arranca sin ella.
DJANGO_SECRET_KEY=genera-una-con-get_random_secret_key
# Modo depuración. Siempre False en producción.
DJANGO_DEBUG=True
# Hosts permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── META — WhatsApp Cloud API ─────────────────────────────────────────────

# Token permanente de un usuario del sistema para enviar mensajes.
META_WA_KOOXI_TOKEN=tu-token-de-whatsapp-cloud-api
# ID del número emisor (el de Kooxi).
META_WA_KOOXI_ID=tu-phone-number-id
# Número público que ve el cliente en los enlaces wa.me (dígitos con código de país).
META_WA_KOOXI_NUMERO=52XXXXXXXXXX
# App Secret de la app de Meta; firma del webhook (sin él se rechaza todo).
META_WA_APP_SECRET=app-secret-de-la-app-de-meta
# Token de verificación del webhook de WhatsApp.
META_WA_WEBHOOK_TOKEN=inventa-un-token-largo
# Versión de la Graph API.
META_WA_API_VERSION=v20.0
# Idioma de las plantillas aprobadas.
META_WA_PLANTILLA_IDIOMA=es_MX
# Plantilla de cotización al cliente.
META_WA_PLANTILLA_COTIZACION=
# Plantilla de confirmación de pago.
META_WA_PLANTILLA_PAGO=
# Plantilla de recordatorio de pago.
META_WA_PLANTILLA_RECORDATORIO=
# Plantilla de la guía pre-evento.
META_WA_PLANTILLA_GUIA=
# Plantilla de seguimiento a cotizaciones sin pago (vacía = el cron no manda nada).
META_WA_PLANTILLA_SEGUIMIENTO=
# Plantilla de alerta interna (nueva cotización).
META_WA_PLANTILLA_ALERTA_INTERNA=
# Plantilla de alerta interna de pago acreditado.
META_WA_PLANTILLA_ALERTA_PAGO=
# Plantilla de alerta interna de contracargo.
META_WA_PLANTILLA_ALERTA_CONTRACARGO=
# Plantilla (documento) de solicitud de factura al contador.
META_WA_PLANTILLA_SOLICITUD_FACTURA=
# Plantilla de avisos internos y de operaciones («Tienes un aviso nuevo: {{1}}»).
META_WA_PLANTILLA_OPERACIONES=

# ─── ANTHROPIC — modelo de Kooxi ───────────────────────────────────────────

# Llave de la API de Anthropic para el agente, el juez y el resumen de preguntas.
ANTHROPIC_API_KEY_KOOXI=tu-llave-de-anthropic

# ─── OPENPAY — cobros ──────────────────────────────────────────────────────

# Ambiente: sandbox o production (cambia URL de la API y Openpay.js).
OPENPAY_PAGOS_MODO=sandbox
# Merchant ID del comercio.
OPENPAY_PAGOS_ID=tu-merchant-id
# Llave privada de la API (cargos y reembolsos).
OPENPAY_PAGOS_SECRET=tu-llave-privada
# Llave pública que usa Openpay.js en el portal.
OPENPAY_PAGOS_API_KEY_PUBLICA=tu-llave-publica
# Usuario de la autenticación básica del webhook.
OPENPAY_WEBHOOK_USUARIO=tu-usuario-webhook
# Contraseña de la autenticación básica del webhook.
OPENPAY_WEBHOOK_SECRET=tu-password-webhook

# ─── CLOUDFLARE — R2 (archivos) ────────────────────────────────────────────

# ID de la cuenta de Cloudflare (parte del endpoint de R2).
CLOUDFLARE_R2_CUENTA_ID=tu-account-id
# Access key del bucket público.
CLOUDFLARE_R2_PUBLICO_ID=tu-access-key-id
# Secret key del bucket público.
CLOUDFLARE_R2_PUBLICO_SECRET=tu-secret-access-key
# Nombre del bucket público.
CLOUDFLARE_R2_PUBLICO_BUCKET=qkt-media
# Dominio público del bucket (media).
CLOUDFLARE_R2_PUBLICO_URL=media.quintakooxtanil.com
# Bucket privado (vacío = esos archivos siguen en el público). Se define al final del corte, ver docs/security.
CLOUDFLARE_R2_PRIVADO_BUCKET=
# Access key del bucket privado (si va vacía usa la del público).
CLOUDFLARE_R2_PRIVADO_ID=
# Secret key del bucket privado (si va vacía usa la del público).
CLOUDFLARE_R2_PRIVADO_SECRET=
# Segundos de validez de las URLs firmadas.
CLOUDFLARE_R2_PRIVADO_URL_SEGUNDOS=300

# ─── BREVO — correo ────────────────────────────────────────────────────────

# API key de Brevo para enviar correo.
BREVO_EMAIL_API_KEY=tu-api-key-de-brevo

# ─── JIBBLE — asistencia y nómina ──────────────────────────────────────────

# Client ID de la API de Jibble.
JIBBLE_NOMINA_ID=tu-client-id-de-jibble
# Client secret de la API de Jibble.
JIBBLE_NOMINA_SECRET=tu-client-secret-de-jibble

# ─── ERP — correo ──────────────────────────────────────────────────────────

# Remitente por defecto (alimenta DEFAULT_FROM_EMAIL de Django).
ERP_EMAIL_REMITENTE=tu-correo@gmail.com
# Remitente de cotizaciones, contratos y guías.
ERP_EMAIL_REMITENTE_RESERVAS=reservas@tu-dominio.com
# Remitente de pagos, recordatorios y facturas.
ERP_EMAIL_REMITENTE_PAGOS=pagos@tu-dominio.com
# Remitente de alertas internas.
ERP_EMAIL_REMITENTE_NOTIFICACIONES=notificaciones@tu-dominio.com

# ─── ERP — sitio y portal ──────────────────────────────────────────────────

# URL canónica del sitio (enlaces en correos).
ERP_SITIO_URL=https://erp-qkt.up.railway.app
# URL base del portal del cliente (enlaces, correos y avisos).
ERP_PORTAL_URL=https://erp.quintakooxtanil.com
# Intentos fallidos por cotización antes de bloquear el acceso al portal.
ERP_PORTAL_ACCESO_MAX=10
# Ventana (segundos) del bloqueo del portal.
ERP_PORTAL_ACCESO_VENTANA_SEGUNDOS=900

# ─── ERP — seguridad ───────────────────────────────────────────────────────

# Intentos fallidos por IP en /admin/login/.
ERP_ADMIN_LOGIN_MAX_IP=10
# Intentos fallidos por usuario en /admin/login/.
ERP_ADMIN_LOGIN_MAX_USUARIO=20
# Ventana (segundos) del bloqueo del login.
ERP_ADMIN_LOGIN_VENTANA_SEGUNDOS=900
# Segundos de inactividad antes de cerrar la sesión.
ERP_SESION_INACTIVIDAD_SEGUNDOS=1800
# Proxies de confianza delante de la app (el edge de Railway = 1).
ERP_RATELIMIT_PROXIES=1
# Enciende la CSP de las páginas públicas.
ERP_CSP_PUBLICO_ACTIVO=True
# CSP pública en modo prueba (solo reporta).
ERP_CSP_PUBLICO_SOLO_REPORTE=False
# CSP del portal en modo prueba.
ERP_CSP_PORTAL_SOLO_REPORTE=False
# CSP del admin en modo prueba.
ERP_CSP_ADMIN_SOLO_REPORTE=False
# Token que autoriza el webhook de sincronización de Jibble.
ERP_NOMINA_WEBHOOK_TOKEN=genera-un-token
# Llave Fernet que cifra la e.firma (la genera el ERP, no el SAT). Generar una y no perderla.
ERP_SAT_FIEL_CIFRADO_SECRET=llave-fernet

# ─── ERP — negocio ─────────────────────────────────────────────────────────

# Tasa del Impuesto Sobre Hospedaje como proporción (0.05 = 5%). Debe coincidir en web y Programador.
ERP_FISCAL_TASA_ISH=0
# Número de registro PROFECO del contrato de Evento/Pasadía (vacío = sin leyenda).
ERP_PROFECO_REGISTRO_EVENTOS=
# Registro PROFECO del contrato de Hospedaje (vacío = sin leyenda).
ERP_PROFECO_REGISTRO_HOSPEDAJE=
# Emite el contrato al confirmarse la cotización.
ERP_CONTRATO_AUTOMATICO_ACTIVO=True
# Usa los contratos propios (False = modelo PROFECO).
ERP_CONTRATO_PROPIO_ACTIVO=True
# Respaldo transitorio del directorio de responsables (#421); se borra cuando el directorio sea la única fuente.
ERP_WA_NEGOCIO_NUMERO=52XXXXXXXXXX

# ─── ERP — Kooxi (agente de WhatsApp) ──────────────────────────────────────

# Enciende al agente (apagado = no contesta).
ERP_KOOXI_ACTIVO=False
# Si no está vacía, solo contesta a estos números (coma).
ERP_KOOXI_NUMEROS_PRUEBA=
# Modelo del agente.
ERP_KOOXI_MODELO=claude-opus-5-5
# Esfuerzo de razonamiento del modelo.
ERP_KOOXI_ESFUERZO=medium
# Enciende al juez que revisa cada respuesta.
ERP_KOOXI_JUEZ_ACTIVO=True
# Modelo del juez y del resumen semanal de preguntas.
ERP_KOOXI_MODELO_JUEZ=claude-haiku-4-5
# Horas de pausa si una persona contesta desde la app.
ERP_KOOXI_PAUSA_HUMANO_HORAS=12
# Tope de respuestas del modelo por número al día.
ERP_KOOXI_MAX_RESPUESTAS_NUMERO_DIA=30
# Tope global de respuestas del modelo al día.
ERP_KOOXI_MAX_RESPUESTAS_DIA=300
# Historial máximo que se reenvía al modelo (caracteres).
ERP_KOOXI_MAX_HISTORIAL_CARACTERES=40000
# Días tras crearse una cotización sin pago para el seguimiento.
ERP_KOOXI_SEGUIMIENTO_DIAS=3
