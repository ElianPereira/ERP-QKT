{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git:*)",
      "Bash(gh pr create:*)",
      "Bash(pytest:*)",
      "Bash(python manage.py test:*)",
      "Bash(python manage.py makemigrations --check:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Read(**)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(python manage.py migrate:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(**/comercial/views_openpay.py)",
      "Edit(**/comercial/services_openpay.py)",
      "Edit(**/legal/**)",
      "Edit(**/contabilidad/services.py)"
    ]
  }
}
