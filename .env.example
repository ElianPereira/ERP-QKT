# Copia este archivo a .env y completa los valores.
#   cp .env.example .env
#
# Ningún valor de este archivo es real: son placeholders o los defaults
# públicos ya presentes en core_erp/settings.py.

# ─── Core Django (obligatorio) ────────────────────────────────────────────
# Sin default en el código: el servidor no arranca sin esta variable.
SECRET_KEY=genera-una-con-get_random_secret_key

# ─── Recomendadas para reproducir el entorno local ────────────────────────
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Si no se define, cae a SQLite local (db.sqlite3) — solo obligatoria en
# producción (Railway). Formato: postgres://usuario:password@host:puerto/nombre
DATABASE_URL=

# ─── Email / Brevo (opcional) ──────────────────────────────────────────────
DEFAULT_FROM_EMAIL=tu-correo@gmail.com
BREVO_API_KEY=tu-api-key-de-brevo

# ─── Cloudflare R2 (storage de archivos activo, opcional en local) ─────────
CLOUDFLARE_R2_ACCOUNT_ID=tu-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=tu-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=tu-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=qkt-media
CLOUDFLARE_R2_CUSTOM_DOMAIN=media.quintakooxtanil.com

# ─── Cloudinary (ya no es el storage activo — ver nota en settings.py; se
# mantiene solo porque migraciones históricas necesitan poder importar el
# paquete) ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ─── Openpay (opcional) ─────────────────────────────────────────────────────
OPENPAY_MODE=sandbox
OPENPAY_MERCHANT_ID=tu-merchant-id
OPENPAY_PRIVATE_KEY=tu-private-key
OPENPAY_PUBLIC_KEY=tu-public-key
OPENPAY_WEBHOOK_USER=tu-usuario-webhook
OPENPAY_WEBHOOK_PASSWORD=tu-password-webhook

# ─── WhatsApp Cloud API / Jibble / iCal / Nómina (opcional) ────────────────
WA_CLOUD_API_TOKEN=tu-token-de-whatsapp-cloud-api
WA_PHONE_NUMBER_ID=tu-phone-number-id
# Ya es público en el código (comercial/views_cotizador.py); se documenta
# aquí solo como referencia del formato esperado.
WA_NUMERO_NEGOCIO=529991699191
JIBBLE_CLIENT_ID=tu-client-id-de-jibble
JIBBLE_CLIENT_SECRET=tu-client-secret-de-jibble
NOMINA_CRON_TOKEN=genera-un-token-para-el-cron-de-nomina
ICAL_PUBLIC_TOKEN=genera-un-token-para-el-feed-ical-publico

# ─── Seguridad / CSP / rate limiting / sesión (opcional, ya con default seguro) ─
RATELIMIT_TRUSTED_PROXY_COUNT=1
PORTAL_URL=https://erp.quintakooxtanil.com
SITE_URL=https://erp-qkt.up.railway.app
SESSION_IDLE_TIMEOUT=1800
PUBLIC_CSP_ENABLED=True
PUBLIC_CSP_REPORT_ONLY=False
PORTAL_CSP_REPORT_ONLY=False
